# Eclipse Reconciler Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Agent Autonomy Settings
MOCK_LLM_MODE=true
AUTO_APPROVAL_THRESHOLD_INR=25000
MIN_CONFIDENCE_THRESHOLD=0.75

# Mock ERP Connection
MOCK_ERP_URL=http://localhost:8001
MOCK_ERP_API_KEY=mock-erp-secret-key-12345

# LLM Provider (Optional if MOCK_LLM_MODE=true)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Database
DATABASE_URL=sqlite+aiosqlite:///./reconciler.db
